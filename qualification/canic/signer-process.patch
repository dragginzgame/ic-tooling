+++ b/crates/canic-host/src/signed/process.rs
@@ -0,0 +1,71 @@
+//! Private bounded signer capture; key and reply policy remain with the caller.
+use ic_host_process_next::{Input, Ownership, Policy, Report, Stderr, Stream};
+use std::{io, process::Command, sync::atomic::AtomicBool, time::Duration};
+
+#[derive(Debug)]
+pub(super) struct CaptureFailure {
+    report: Report,
+    stdout: Vec<u8>,
+    stderr: Vec<u8>,
+}
+
+impl std::fmt::Display for CaptureFailure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(
+            f,
+            "signer execution refused: status={:?}, failure={:?}, cleanup={}, retained stdout={} stderr={} bytes",
+            self.report.status,
+            self.report.failure,
+            self.report.cleanup.len(),
+            self.stdout.len(),
+            self.stderr.len()
+        )
+    }
+}
+
+impl std::error::Error for CaptureFailure {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        self.report.failure.as_ref().map(|error| error as _)
+    }
+}
+
+pub(super) fn capture(
+    command: &mut Command,
+    stdout_limit: usize,
+    stderr_limit: usize,
+    elapsed: Duration,
+) -> Result<Vec<u8>, CaptureFailure> {
+    let mut stdout = Vec::new();
+    let mut stderr = Vec::new();
+    let report = ic_host_process_next::run(
+        command,
+        Policy {
+            ownership: Ownership::Group,
+            input: Input::Null,
+            stdout_bytes: stdout_limit,
+            stderr: Stderr::Capture(stderr_limit),
+            elapsed,
+        },
+        &AtomicBool::new(false),
+        |stream, bytes| {
+            let buffer = match stream {
+                Stream::Stdout => &mut stdout,
+                Stream::Stderr => &mut stderr,
+            };
+            buffer.try_reserve(bytes.len()).map_err(io::Error::other)?;
+            buffer.extend_from_slice(bytes);
+            Ok(())
+        },
+    );
+    if report.failure.is_some()
+        || !report.cleanup.is_empty()
+        || !report.status.is_some_and(|status| status.success())
+    {
+        return Err(CaptureFailure {
+            report,
+            stdout,
+            stderr,
+        });
+    }
+    Ok(stdout)
+}

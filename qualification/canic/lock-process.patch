+#[derive(Debug)]
+struct LockFailure {
+    report: ic_host_process_next::Report,
+    stdout: Vec<u8>,
+    stderr: Vec<u8>,
+}
+
+impl std::fmt::Display for LockFailure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(
+            f,
+            "Cargo lock initialization failed: status={:?}, failure={:?}, cleanup={:?}",
+            self.report.status, self.report.failure, self.report.cleanup
+        )?;
+        let partial = matches!(
+            self.report.failure,
+            Some(ic_host_process_next::Failure::Limit(_))
+        );
+        if let Some(diagnostic) =
+            crate::artifact::cargo_diagnostic_bytes(&self.stdout, &self.stderr, partial)
+        {
+            write!(f, "\n{diagnostic}")?;
+        }
+        Ok(())
+    }
+}
+
+impl std::error::Error for LockFailure {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        self.report.failure.as_ref().map(|error| error as _)
+    }
+}
+
+fn initialize_lock(command: &mut Command) -> Result<()> {
+    use ic_host_process_next::{Input, Ownership, Policy, Stderr, Stream};
+    let mut stdout = Vec::new();
+    let mut stderr = Vec::new();
+    let report = ic_host_process_next::run(
+        command,
+        Policy {
+            ownership: Ownership::Group,
+            input: Input::Null,
+            stdout_bytes: 1024 * 1024,
+            stderr: Stderr::Capture(1024 * 1024),
+            elapsed: Duration::from_secs(120),
+        },
+        &std::sync::atomic::AtomicBool::new(false),
+        |stream, bytes| {
+            let buffer = match stream {
+                Stream::Stdout => &mut stdout,
+                Stream::Stderr => &mut stderr,
+            };
+            buffer
+                .try_reserve(bytes.len())
+                .map_err(std::io::Error::other)?;
+            buffer.extend_from_slice(bytes);
+            Ok(())
+        },
+    );
+    if report.failure.is_some()
+        || !report.cleanup.is_empty()
+        || !report.status.is_some_and(|status| status.success())
+    {
+        return Err(supplier(LockFailure {
+            report,
+            stdout,
+            stderr,
+        }));
+    }
+    Ok(())
+}

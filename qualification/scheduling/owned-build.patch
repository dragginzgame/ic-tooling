+//! Timers-owned admission and receipt identity, not a Cargo precedence model.
+use ic_byte_admission::{Length, read};
+use ic_custody::{Access, Directory, FilePolicy};
+use ic_host_artifacts::artifact::Sha256Digest;
+use std::{
+    collections::BTreeSet,
+    ffi::OsStr,
+    io,
+    path::{Path, PathBuf},
+};
+use toml::Value;
+
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+const FILE_BYTES: u64 = 1024 * 1024;
+const TOTAL_BYTES: usize = 16 * 1024 * 1024;
+const FILES: usize = 128;
+const DEPTH: usize = 32;
+const COMPILERS: &[&str] = &[
+    "RUSTC",
+    "RUSTDOC",
+    "RUSTC_WRAPPER",
+    "RUSTC_WORKSPACE_WRAPPER",
+    "CARGO_BUILD_RUSTC",
+    "CARGO_BUILD_RUSTDOC",
+    "CARGO_BUILD_RUSTC_WRAPPER",
+    "CARGO_BUILD_RUSTC_WORKSPACE_WRAPPER",
+];
+
+fn invalid() -> Box<dyn std::error::Error> {
+    io::Error::new(
+        io::ErrorKind::InvalidData,
+        "Cargo configuration refused (structure, compiler override or resource bound)",
+    )
+    .into()
+}
+fn present(path: &Path) -> io::Result<bool> {
+    match path.symlink_metadata() {
+        Ok(_) => Ok(true),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(false),
+        Err(error) => Err(error),
+    }
+}
+fn roots(
+    invocation: &Path,
+    cargo_home: Option<&OsStr>,
+    home: Option<&OsStr>,
+) -> Result<Vec<PathBuf>> {
+    if !invocation.is_absolute() {
+        return Err(invalid());
+    }
+    let mut directories: Vec<_> = invocation.ancestors().map(|p| p.join(".cargo")).collect();
+    if let Some(home) = cargo_home
+        .map(PathBuf::from)
+        .or_else(|| home.map(|p| Path::new(p).join(".cargo")))
+    {
+        directories.push(if home.is_absolute() {
+            home
+        } else {
+            invocation.join(home)
+        });
+    }
+    let mut paths = Vec::new();
+    for directory in directories {
+        for name in ["config", "config.toml"] {
+            let path = directory.join(name);
+            if present(&path)? {
+                paths.push(path);
+                break;
+            }
+        }
+    }
+    Ok(paths)
+}

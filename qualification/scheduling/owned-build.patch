+#[test]
+fn configuration_selection_includes_and_drift_are_explicit() {
+    let fixture = fixture();
+    let root = fixture.path();
+    fs::create_dir(root.join(".cargo")).unwrap();
+    let config = root.join(".cargo/config");
+    fs::write(
+        &config,
+        "include = ['child.toml', {path='absent', optional=true}]\n",
+    )
+    .unwrap();
+    fs::write(root.join(".cargo/config.toml"), "malformed fallback").unwrap();
+    let child = root.join(".cargo/child.toml");
+    fs::write(&child, "[build]\njobs=2\n").unwrap();
+    assert!(roots(root, None, None).unwrap().contains(&config));
+    assert!(
+        !roots(root, None, None)
+            .unwrap()
+            .contains(&root.join(".cargo/config.toml"))
+    );
+    let before = observe(vec![config.clone()]).unwrap();
+    assert_eq!(before.0.len(), 2);
+    assert_eq!(before, observe(vec![config.clone()]).unwrap());
+    fs::write(&child, "[build]\njobs=3\n").unwrap();
+    let after = observe(vec![config.clone()]).unwrap();
+    assert_ne!(before.1, after.1);
+    for declaration in [
+        "[build]\nrustc=''",
+        "[env]\nRUSTC_WRAPPER={value='',force=false}",
+        "[env]\nCARGO_BUILD_RUSTDOC='secret-tool'",
+    ] {
+        fs::write(&child, declaration).unwrap();
+        let error = observe(vec![config.clone()]).unwrap_err();
+        assert!(!error.to_string().contains("secret-tool"));
+    }
+    fs::write(&config, "include='required-missing'").unwrap();
+    assert!(
+        observe(vec![config])
+            .unwrap_err()
+            .downcast_ref::<io::Error>()
+            .is_some_and(|e| e.kind() == io::ErrorKind::NotFound)
+    );
+}
+#[test]
+fn unsafe_invalid_and_excessive_configurations_refuse_without_text_leakage() {
+    let fixture = fixture();
+    let root = fixture.path();
+    let config = root.join("config");
+    for text in [
+        "token = 'PRIVATE-secret",
+        "include=17",
+        "[env]\nRUSTC={value='PRIVATE-secret'}",
+        "build='PRIVATE-secret'",
+    ] {
+        fs::write(&config, text).unwrap();
+        let error = observe(vec![config.clone()]).unwrap_err();
+        assert!(!format!("{error:?}").contains("PRIVATE-secret"));
+    }
+    fs::write(&config, "include='config'").unwrap();
+    assert!(observe(vec![config.clone()]).is_err());
+    fs::write(&config, vec![b' '; FILE_BYTES as usize + 1]).unwrap();
+    assert!(observe(vec![config.clone()]).is_err());
+    fs::remove_file(&config).unwrap();
+    fs::write(root.join("target"), "[build]\njobs=1").unwrap();
+    std::os::unix::fs::symlink("target", &config).unwrap();
+    assert!(observe(vec![config.clone()]).is_err());
+    fs::remove_file(&config).unwrap();
+    fs::write(&config, "").unwrap();
+    // Distinct optional lookups still spend the traversal budget.
+    fs::write(
+        &config,
+        format!(
+            "include=[{}]",
+            (0..129)
+                .map(|n| format!("{{path='missing{n}', optional=true}}"))
+                .collect::<Vec<_>>()
+                .join(",")
+        ),
+    )
+    .unwrap();
+    assert!(observe(vec![config]).is_err());
+    for n in 0..34 {
+        fs::write(
+            root.join(format!("depth{n}")),
+            format!("include='depth{}'", n + 1),
+        )
+        .unwrap();
+    }
+    assert!(observe(vec![root.join("depth0")]).is_err());
+    let mut paths = Vec::new();
+    for n in 0..17 {
+        let path = root.join(format!("large{n}"));
+        fs::write(&path, vec![b' '; FILE_BYTES as usize]).unwrap();
+        paths.push(path);
+    }
+    assert!(observe(paths).is_err());
+}

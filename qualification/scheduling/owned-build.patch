+// Receipt data holds only paths and digests, never parsed values or source text.
+pub(super) fn snapshot(
+    invocation: &Path,
+    cargo_home: Option<&OsStr>,
+    home: Option<&OsStr>,
+) -> Result<(Vec<(PathBuf, String)>, String)> {
+    observe(roots(invocation, cargo_home, home)?)
+}
+fn observe(roots: Vec<PathBuf>) -> Result<(Vec<(PathBuf, String)>, String)> {
+    let mut pending: Vec<_> = roots
+        .into_iter()
+        .rev()
+        .map(|path| (path, false, Vec::<PathBuf>::new()))
+        .collect();
+    let mut seen = BTreeSet::new();
+    let mut total = 0;
+    let mut attempts = 0;
+    let mut files = Vec::new();
+    while let Some((path, optional, ancestors)) = pending.pop() {
+        if ancestors.len() > DEPTH || attempts == FILES {
+            return Err(invalid());
+        }
+        attempts += 1;
+        if !path.is_absolute() {
+            return Err(invalid());
+        }
+        if !present(&path)? {
+            if optional {
+                continue;
+            }
+            return Err(io::Error::from(io::ErrorKind::NotFound).into());
+        }
+        let location = path.canonicalize()?;
+        if ancestors.contains(&location) {
+            return Err(invalid());
+        }
+        if !seen.insert(path.clone()) {
+            continue;
+        }
+        let parent = path.parent().ok_or_else(invalid)?;
+        let directory =
+            Directory::open(parent, 0)?.ok_or_else(|| io::Error::from(io::ErrorKind::NotFound))?;
+        let file = directory
+            .open_file(
+                path.file_name().ok_or_else(invalid)?,
+                Access::Read,
+                FilePolicy {
+                    forbidden: 0,
+                    single_link: false,
+                },
+            )?
+            .ok_or_else(|| io::Error::from(io::ErrorKind::NotFound))?;
+        let (bytes, identity) = read(
+            file,
+            Length::AtMost(FILE_BYTES.min((TOTAL_BYTES - total) as u64)),
+        )?;
+        total += bytes.len();
+        // Suppress parser details: they may include credentials from the input.
+        let config: Value = toml::from_str(std::str::from_utf8(&bytes).map_err(|_| invalid())?)
+            .map_err(|_| invalid())?;
+        for (table, names) in [
+            (
+                "build",
+                &[
+                    "rustc",
+                    "rustdoc",
+                    "rustc-wrapper",
+                    "rustc-workspace-wrapper",
+                ][..],
+            ),
+            ("env", COMPILERS),
+        ] {
+            if let Some(value) = config.get(table) {
+                let values = value.as_table().ok_or_else(invalid)?;
+                if names.iter().any(|name| values.contains_key(*name)) {
+                    return Err(invalid());
+                }
+            }
+        }
+        files.push((
+            path.clone(),
+            Sha256Digest::from_bytes(identity.sha256).to_string(),
+        ));
+        if let Some(include) = config.get("include") {
+            let values = match include {
+                Value::Array(values) => values.as_slice(),
+                value => std::slice::from_ref(value),
+            };
+            if pending.len() + values.len() > FILES {
+                return Err(invalid());
+            }
+            let mut ancestors = ancestors;
+            ancestors.push(location);
+            for value in values.iter().rev() {
+                let (name, optional) = match value {
+                    Value::String(name) => (name.as_str(), false),
+                    Value::Table(fields) => (
+                        fields
+                            .get("path")
+                            .and_then(Value::as_str)
+                            .ok_or_else(invalid)?,
+                        fields
+                            .get("optional")
+                            .map(|v| v.as_bool().ok_or_else(invalid))
+                            .transpose()?
+                            .unwrap_or(false),
+                    ),
+                    _ => return Err(invalid()),
+                };
+                pending.push((parent.join(name), optional, ancestors.clone()));
+            }
+        }
+    }
+    let digests: Vec<_> = files.iter().map(|(_, digest)| digest).collect();
+    let recipe = Sha256Digest::compute(&serde_json::to_vec(&digests)?).to_string();
+    Ok((files, recipe))
+}
+
+pub(super) fn recipe(request: &ic_build::BuildRequest, configuration: &str) -> Result<String> {
+    let mut environment: Vec<_> = request
+        .environment
+        .iter()
+        .filter(|(name, _)| {
+            name.to_str().is_some_and(|name| {
+                matches!(
+                    name,
+                    "RUSTFLAGS"
+                        | "RUSTDOCFLAGS"
+                        | "CARGO_ENCODED_RUSTFLAGS"
+                        | "CARGO_ENCODED_RUSTDOCFLAGS"
+                        | "CARGO_INCREMENTAL"
+                        | "RUSTC_BOOTSTRAP"
+                ) || name.starts_with("CARGO_BUILD_")
+                    || name.starts_with("CARGO_PROFILE_")
+                    || name.starts_with("CARGO_TARGET_") && name != "CARGO_TARGET_DIR"
+            })
+        })
+        .map(|(name, value)| (name.as_encoded_bytes(), value.as_encoded_bytes()))
+        .collect();
+    environment.sort();
+    let bytes = serde_json::to_vec(&(
+        "owned-build-v1",
+        &request.package,
+        &request.library,
+        &request.profile,
+        &request.features,
+        request.default_features,
+        "wasm32-unknown-unknown",
+        "locked-offline",
+        configuration,
+        environment,
+    ))?;
+    Ok(format!("owned-build-v1/{}", Sha256Digest::compute(&bytes)))
+}

+fn retain(source: &fs::File, destination: &Path, held: &Directory) -> io::Result<()> {
+    let name = destination
+        .file_name()
+        .ok_or_else(|| io::Error::other("missing destination name"))?;
+    let staging = held
+        .stage(
+            OsStr::new(STAGING),
+            name,
+            Policy {
+                destination: Destination::Replace,
+                permissions: 0o600,
+                retention: Retention::Retain,
+            },
+        )
+        .map_err(io::Error::other)?;
+    let sealed = staging
+        .write_from(source, Length::Exactly(source.metadata()?.len()))
+        .map_err(io::Error::other)?
+        .seal()
+        .map_err(io::Error::other)?;
+    let outcome = sealed.commit();
+    let retained_path = match &outcome {
+        Commit::Committed(_) => return Ok(()),
+        Commit::NotPublished { .. } => destination.with_file_name(STAGING),
+        Commit::PublishedUnconfirmed { .. } => destination.to_owned(),
+    };
+    Err(io::Error::other(CaptureFailure {
+        retained_path,
+        outcome,
+    }))
+}

+        CborError::Decode(_) => CborErrorKind::Decode,
+        CborError::OutputTooLarge => CborErrorKind::OutputTooLarge,
+        CborError::Encode(_) => CborErrorKind::Encode,
+    };
+    ClientError::Cbor {
